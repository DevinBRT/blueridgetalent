---
import BaseLayout from '../layouts/BaseLayout.astro';
import BackgroundVideo from '../components/BackgroundVideo.astro';
import ContactForm from '../components/ContactForm.astro';
import LinkedInButton from '../components/LinkedInButton.astro';
import ExternalIcon from '../components/ExternalIcon.astro';
import { links } from '../data/site';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Blue Ridge Talent about talent advisory, embedded recruiting, or professional search."
>
  <section class="contact bg-section">
    <div class="bg-media">
      <BackgroundVideo name="mountains" />
      <div class="overlay"></div>
    </div>

    <div class="container layout">
      <div class="intro">
        <h1 class="heading">Let’s Connect</h1>
        <p class="lead">
          Every engagement starts with a conversation. Tell us a little about your team and what you’re working toward.
        </p>
        <ul class="details">
          <li><span>Email</span><a href={`mailto:${links.email}`}>{links.email}</a></li>
          <li><span>Based in</span>Charlotte, North Carolina</li>
          <li><span>Looking for a job?</span><a href={links.openRoles} target="_blank" rel="noopener">See our open roles <ExternalIcon /></a></li>
        </ul>
        <div class="social"><LinkedInButton /></div>
      </div>
      <div class="form-card">
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    min-height: max(100svh, 760px);
    padding: calc(var(--header-height) + clamp(40px, 6vw, 96px)) 0 clamp(64px, 7vw, 112px);
    background: var(--navy);
    color: var(--cream);
  }
  .overlay { background: rgb(15 23 48 / 0.35); }

  .layout {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .heading {
    font-size: var(--size-h1);
    margin-bottom: 0.3em;
  }
  .lead { max-width: 30ch; margin-bottom: 32px; }

  .details {
    margin: 0 0 28px;
    padding: 0;
    list-style: none;
  }
  .details li {
    display: flex;
    flex-direction: column;
    margin-bottom: 16px;
    font-size: 1rem;
  }
  .details span {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .details a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    overflow-wrap: anywhere;
  }

  .form-card {
    padding: clamp(24px, 3vw, 40px);
    background: rgb(15 23 48 / 0.55);
    border: 1px solid rgb(255 245 217 / 0.18);
    border-top: 3px solid var(--gold);
    border-radius: var(--radius);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  @media (max-width: 899px) {
    .layout { grid-template-columns: 1fr; }
  }
</style>
