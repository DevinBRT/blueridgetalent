---
import BaseLayout from '../layouts/BaseLayout.astro';
import BackgroundVideo from '../components/BackgroundVideo.astro';
---

<BaseLayout title="Page Not Found" description="This page could not be found." noindex>
  <section class="not-found bg-section">
    <div class="bg-media">
      <BackgroundVideo name="mountains-down" opacity={0.7} fadeLoop speed={0.7} />
    </div>
    <div class="text">
      <h1>Page Not Found</h1>
      <p>The page you're looking for doesn't exist or has moved.</p>
      <p><a href="/">Back to home</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 100svh;
    background: var(--navy);
    color: var(--cream);
    text-align: center;
  }
  .text {
    padding: calc(var(--header-height) + 90px) var(--gutter) 80px;
    font-size: var(--size-body);
  }
</style>
