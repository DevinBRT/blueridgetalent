---
import BaseLayout from '../layouts/BaseLayout.astro';
import RoadTogether from '../components/RoadTogether.astro';
import CtaBand from '../components/CtaBand.astro';

const beliefs = [
  {
    title: 'Recruiting fanatics',
    text: 'We genuinely love what we do because we believe exceptional talent changes companies. Our mission is to help organizations identify, hire, and retain the people who will shape their future.',
  },
  {
    title: 'Lasting value',
    text: 'Whether we’re advising, embedding alongside your team, or leading a critical search, success isn’t measured by accepted offers. It’s measured by stronger teams and healthier hiring practices.',
  },
  {
    title: 'Intentionally transient',
    text: 'We identify the root causes of hiring challenges, build sustainable solutions, and empower you to own them long after we’re gone. Did we leave your organization stronger than we found it?',
  },
  {
    title: 'People-first cultures',
    text: 'The strongest companies are built by people who are empowered to do their best work. Every engagement is guided by integrity, transparency, curiosity, and a commitment to lasting value.',
  },
  {
    title: 'People, process & technology',
    text: 'We’re always exploring how technology, including AI, can improve the hiring experience without replacing the human relationships that make great companies possible.',
  },
];
---

<BaseLayout
  title="About"
  description="Founded by Devin Moretz in 2023, Blue Ridge Talent helps organizations identify, hire, and retain great people while building recruiting strategies that are sustainable, scalable, and centered around people."
>
  <section class="page-hero bg-section">
    <div class="bg-media">
      <img src="/images/about-mountains.jpg" alt="" width="2500" height="1667" />
      <div class="overlay"></div>
    </div>
    <div class="container">
      <span class="eyebrow">About</span>
      <h1>About Blue Ridge Talent</h1>
      <p class="lead">Founded in 2023 by Devin Moretz, built on a better way to recruit.</p>
    </div>
  </section>

  <!-- Story -->
  <section class="section section--cream" id="story">
    <div class="container split split--top">
      <div class="prose">
        <span class="eyebrow">Our story</span>
        <h2>There had to be a better way</h2>
        <p class="lead">
          Blue Ridge Talent was founded by Devin Moretz in 2023 with a simple belief: there is a better way to support
          organizations than simply delivering a résumé followed by an invoice.
        </p>
        <p>
          After experiencing the recruiting industry from every angle — including temporary staffing,
          executive search, RPO, embedded recruiting, in-house talent acquisition, and consulting — we observed gaps in the
          traditional recruiting model. Too often, recruiting is treated as a transactional service rather than a strategic
          function capable of transforming an organization.
        </p>
        <p>We knew there had to be a better, more sustainable way.</p>
      </div>
      <figure class="quote">
        <blockquote>
          “Did we leave your organization stronger than we found it?”
        </blockquote>
        <figcaption>The one question we measure ourselves by</figcaption>
      </figure>
    </div>
  </section>

  <!-- Beliefs -->
  <section class="section section--light" id="beliefs">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What we believe</span>
        <h2>The principles behind every engagement</h2>
      </div>
      <div class="card-grid beliefs">
        {beliefs.map((b, i) => (
          <article class="card">
            <span class="card-number">{String(i + 1).padStart(2, '0')}</span>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Approach -->
  <RoadTogether id="approach" />

  <CtaBand heading="Let’s talk about your team" />
</BaseLayout>

<style>
  /* Five cards: three across, then two wider ones, so none sits alone */
  @media (min-width: 900px) {
    .beliefs { grid-template-columns: repeat(6, 1fr); }
    .beliefs > :nth-child(-n + 3) { grid-column: span 2; }
    .beliefs > :nth-child(n + 4) { grid-column: span 3; }
  }

  .page-hero .overlay {
    background: linear-gradient(to bottom, rgb(15 23 48 / 0.5) 0%, rgb(15 23 48 / 0.2) 40%, rgb(15 23 48 / 0.7) 100%);
  }

  .quote {
    margin: 0;
    padding: clamp(32px, 4vw, 56px);
    background: var(--navy);
    color: var(--cream);
    border-radius: var(--radius);
    border-left: 4px solid var(--gold);
  }
  .quote blockquote {
    margin: 0 0 20px;
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 1.3rem + 1.4vw, 2.6rem);
    line-height: 1.15;
    text-transform: uppercase;
  }
  .quote figcaption {
    font-size: 15px;
    color: var(--gold);
    font-weight: 600;
    letter-spacing: 0.04em;
  }
</style>
