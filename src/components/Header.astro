---
/**
 * Site header: centered logo + menu on desktop, logo + menu button on phones.
 * `tone` sets the text color so it reads against each page's background:
 *   "light" = cream text (for dark backgrounds), "dark" = navy text.
 */
interface Props {
  tone?: 'light' | 'dark';
}
const { tone = 'light' } = Astro.props;
const current = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';

const nav = [
  { href: '/services', label: 'Services' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<header class={`site-header tone-${tone}`}>
  <div class="header-inner">
    <a class="site-title" href="/">Blue Ridge Talent</a>
    <nav class="desktop-nav" aria-label="Main">
      {nav.map((item) => (
        <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu">
      <span class="visually-hidden">Open menu</span>
      <span class="burger" aria-hidden="true"></span>
    </button>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu" hidden>
  <div class="mobile-menu-top">
    <a class="site-title" href="/">Blue Ridge Talent</a>
    <button class="menu-close" type="button" aria-label="Close menu">
      <span aria-hidden="true"></span>
    </button>
  </div>
  <nav aria-label="Main">
    {nav.map((item) => (
      <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>
</div>

<script>
  const openBtn = document.querySelector<HTMLButtonElement>('.menu-button')!;
  const closeBtn = document.querySelector<HTMLButtonElement>('.menu-close')!;
  const menu = document.getElementById('mobile-menu')!;

  function setOpen(open: boolean) {
    menu.hidden = !open;
    openBtn.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    (open ? closeBtn : openBtn).focus();
  }

  openBtn.addEventListener('click', () => setOpen(true));
  closeBtn.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) setOpen(false);
  });
  // Close if the window grows to desktop width while the menu is open
  matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
    if (e.matches && !menu.hidden) setOpen(false);
  });
</script>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.16);
  }
  .tone-light { color: var(--cream); }
  .tone-dark { color: var(--navy); }

  .header-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 19px;
  }

  .site-title {
    font-family: var(--font-heading);
    font-size: 24.4px;
    line-height: 1.2;
    text-transform: uppercase;
    text-decoration: none;
  }

  .desktop-nav {
    display: flex;
    gap: 72px;
  }
  .desktop-nav a,
  .mobile-menu nav a {
    text-decoration: none;
  }
  .desktop-nav a {
    font-size: 16px;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
  }
  .desktop-nav a:hover,
  .desktop-nav a[aria-current='page'] {
    border-bottom-color: currentColor;
  }

  .menu-button {
    display: none;
  }

  @media (max-width: 767px) {
    .site-header {
      justify-content: stretch;
      padding: 0 var(--gutter);
    }
    .header-inner {
      flex: 1;
      flex-direction: row;
      justify-content: space-between;
    }
    .site-title { font-size: 16.5px; }
    .desktop-nav { display: none; }
    .menu-button {
      display: block;
      width: 44px;
      height: 44px;
      margin-right: -4px;
      padding: 0;
      background: none;
      border: 0;
      color: inherit;
      cursor: pointer;
    }
    .burger,
    .burger::after {
      display: block;
      width: 35px;
      height: 1px;
      margin: 0 auto;
      background: currentColor;
    }
    .burger { position: relative; top: -6px; }
    .burger::after { content: ''; position: relative; top: 11px; }
  }

  /* ---------- Phone menu overlay ---------- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    background: var(--slate);
    color: var(--navy);
  }
  .mobile-menu[hidden] { display: none; }

  .mobile-menu-top {
    height: 84px;
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .mobile-menu-top .site-title { font-size: 16.5px; }

  .menu-close {
    position: relative;
    width: 44px;
    height: 44px;
    margin-right: -4px;
    padding: 0;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
  }
  .menu-close span::before,
  .menu-close span::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 28px;
    height: 1px;
    background: currentColor;
  }
  .menu-close span::before { transform: translate(-50%, -50%) rotate(45deg); }
  .menu-close span::after { transform: translate(-50%, -50%) rotate(-45deg); }

  .mobile-menu nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 36px;
  }
  .mobile-menu nav a {
    font-size: 32px;
    line-height: 1.15;
  }
</style>
