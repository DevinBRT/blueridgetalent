---
import { nav, links } from '../data/site';
import ExternalIcon from './ExternalIcon.astro';

const services = nav.find((n) => n.label === 'Services')!.children!;
const about = nav.find((n) => n.label === 'About')!.children!;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="brand">
      <a class="wordmark" href="/">Blue Ridge Talent</a>
      <p class="tagline">Elevating the talent experience.</p>
      <p class="blurb">Recruiting and talent advisory based in Charlotte, serving organizations across the Carolinas and beyond.</p>
      <a class="social" href={links.companyLinkedIn} target="_blank" rel="noopener" aria-label="Blue Ridge Talent on LinkedIn">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path fill="currentColor" d="M5.4 3.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4ZM3.7 9h3.4v11H3.7V9Zm5.6 0h3.3v1.5h.1c.5-.9 1.6-1.8 3.3-1.8 3.5 0 4.2 2.3 4.2 5.3V20h-3.4v-5.3c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V20H9.3V9Z"></path>
        </svg>
      </a>
    </div>

    <nav class="col" aria-label="Services">
      <h2>Services</h2>
      <ul>
        {services.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
      </ul>
    </nav>

    <nav class="col" aria-label="Company">
      <h2>Company</h2>
      <ul>
        {about.map((s) => <li><a href={s.href}>{s.label === 'Our Story' ? 'About' : s.label}</a></li>)}
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>

    <div class="col">
      <h2>Connect</h2>
      <ul>
        <li><a href={links.openRoles} target="_blank" rel="noopener">Open Roles <ExternalIcon /></a></li>
        <li><a href={links.companyLinkedIn} target="_blank" rel="noopener">LinkedIn <ExternalIcon /></a></li>
        <li><a href={`mailto:${links.email}`}>{links.email}</a></li>
        <li class="muted">Charlotte, North Carolina</li>
      </ul>
    </div>
  </div>

  <div class="container bottom">
    <p>&copy; {year} Blue Ridge Talent. All rights reserved.</p>
    <a href="#top" class="to-top">Back to top ↑</a>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy-deep);
    color: var(--cream);
    padding-top: clamp(56px, 6vw, 88px);
    font-size: 15px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    gap: 40px;
    padding-bottom: 48px;
  }

  .wordmark {
    font-family: var(--font-heading);
    font-size: 28px;
    text-transform: uppercase;
    text-decoration: none;
  }
  .tagline {
    margin: 6px 0 16px;
    color: var(--gold);
    font-weight: 600;
  }
  .blurb {
    max-width: 34ch;
    opacity: 0.75;
  }
  .social {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-top: 20px;
    border: 1px solid rgb(255 245 217 / 0.35);
    border-radius: 50%;
  }
  .social:hover { background: var(--cream); color: var(--navy); }

  .col h2 {
    margin-bottom: 18px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--gold);
  }
  .col ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .col li { margin-bottom: 10px; }
  .col a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    opacity: 0.8;
    overflow-wrap: anywhere;
  }
  .col a:hover { opacity: 1; text-decoration: underline; }
  .muted { opacity: 0.6; }

  .bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 24px;
    padding-bottom: 28px;
    border-top: 1px solid rgb(255 245 217 / 0.14);
    font-size: 13px;
    opacity: 0.7;
  }
  .bottom p { margin: 0; }
  .to-top { text-decoration: none; }
  .to-top:hover { text-decoration: underline; }

  @media (max-width: 899px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .brand { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .footer-grid { grid-template-columns: 1fr; }
    .bottom { flex-direction: column; }
  }
</style>
