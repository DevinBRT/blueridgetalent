---
/**
 * Closing call to action over the sunset-through-trees video. The band is short,
 * so the video is never stretched far past its 1080p size (the old Services
 * page blew it up to cover a 4,800px-tall section, which made it look blurry).
 */
import BackgroundVideo from './BackgroundVideo.astro';
import ExternalIcon from './ExternalIcon.astro';
import { links } from '../data/site';

interface Props {
  heading?: string;
  text?: string;
}
const {
  heading = 'Let’s build your team the right way',
  text = 'Start with a complimentary conversation about where hiring is getting harder, and what would actually help.',
} = Astro.props;
---

<section class="cta bg-section">
  <div class="bg-media">
    <BackgroundVideo name="sunset-trees" />
    <div class="overlay"></div>
  </div>
  <div class="container inner">
    <h2>{heading}</h2>
    <p class="lead">{text}</p>
    <div class="button-row">
      <a class="button button--cream" href="/contact">Start a conversation</a>
      <a class="button button--outline" href={links.openRoles} target="_blank" rel="noopener">View open roles <ExternalIcon /></a>
    </div>
  </div>
</section>

<style>
  .cta {
    padding: clamp(80px, 9vw, 140px) 0;
    background: var(--navy);
    color: var(--cream);
    text-align: center;
  }
  .overlay { background: rgb(15 23 48 / 0.45); }
  .inner { max-width: 820px; }
  .lead { margin-bottom: 32px; }
  .button-row { justify-content: center; }
</style>
