---
/**
 * Industries Devin recruits in. To add one, add an entry below; `icon` picks
 * one of the line drawings in the `icons` list.
 */
const industries = [
  {
    name: 'Finance',
    icon: 'bank',
    text: 'Financial services and banking teams, from client-facing roles to the specialists behind them.',
  },
  {
    name: 'Insurance',
    icon: 'shield',
    text: 'Carriers and reinsurers hiring across underwriting, claims, risk and corporate functions.',
  },
  {
    name: 'Manufacturing',
    icon: 'gear',
    text: 'Plant, engineering and operations leadership for companies that build things.',
  },
  {
    name: 'Automotive',
    icon: 'car',
    text: 'Dealer groups, suppliers and automotive businesses growing their teams.',
  },
];

const icons: Record<string, string> = {
  bank: 'M3 10h18M5 10v8M9.5 10v8M14.5 10v8M19 10v8M3 21h18M12 3l9 5H3l9-5Z',
  shield: 'M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6l7-3Zm-3 9l2 2 4-4',
  gear: 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm7.4-3a7.4 7.4 0 0 0-.1-1.2l2-1.6-2-3.4-2.4 1a7.5 7.5 0 0 0-2-1.2L14.5 3h-5l-.4 2.6a7.5 7.5 0 0 0-2 1.2l-2.4-1-2 3.4 2 1.6a7.4 7.4 0 0 0 0 2.4l-2 1.6 2 3.4 2.4-1a7.5 7.5 0 0 0 2 1.2l.4 2.6h5l.4-2.6a7.5 7.5 0 0 0 2-1.2l2.4 1 2-3.4-2-1.6c.1-.4.1-.8.1-1.2Z',
  car: 'M5 16h14M5 16v2.5M19 16v2.5M4 16l1.6-5.2A2 2 0 0 1 7.5 9.4h9a2 2 0 0 1 1.9 1.4L20 16M7.5 13h.01M16.5 13h.01',
};

interface Props {
  /** Show the section heading and intro (off when the page supplies its own) */
  heading?: boolean;
}
const { heading = true } = Astro.props;
---

<div class="industries">
  {heading && (
    <div class="section-head">
      <span class="eyebrow">Industries</span>
      <h2>Sectors we know</h2>
      <p>We're industry agnostic, but these are the sectors where we've done our deepest work.</p>
    </div>
  )}
  <div class="card-grid">
    {industries.map((ind) => (
      <article class="card industry">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d={icons[ind.icon]} /></svg>
        <h3>{ind.name}</h3>
        <p>{ind.text}</p>
      </article>
    ))}
  </div>
  <p class="also">Also: engineering, healthcare, consulting and professional services.</p>
</div>

<style>
  .icon {
    width: 44px;
    height: 44px;
    margin-bottom: 18px;
    fill: none;
    stroke: var(--navy);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  :global(.section--navy) .icon { stroke: var(--gold); }
  .also {
    margin-top: 28px;
    font-size: 1rem;
    opacity: 0.8;
  }
</style>
